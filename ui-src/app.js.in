  if (c.time_of_day) bits.push(`@@T:m84a4b9eb1b@@ ${c.time_of_day}`);
  if (c.choice_sensitive) bits.push('@@S:mf78ebf1a6e@@');
  return bits.join(' · ') || '@@S:me13c6137f9@@';
}

